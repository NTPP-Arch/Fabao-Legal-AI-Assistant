# 应用环境
APP_NAME=法宝 - AI法律助手
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# MySQL 5.7（先创建 fabao 数据库，再执行 alembic upgrade head）
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/fabao?charset=utf8mb4

# JWT：请使用 python -c "import secrets; print(secrets.token_hex(32))" 生成随机值
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 允许 Vue 开发服务器访问；多个来源用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 上传设置
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# FastGPT 预留配置（配置 API Key 后自动切换真实 AI 服务）
FASTGPT_BASE_URL=http://localhost:3000
FASTGPT_API_KEY=
FASTGPT_APP_ID=
FASTGPT_CHAT_ID=
